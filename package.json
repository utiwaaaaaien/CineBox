{
  "name": "cinebox-camera-kit",
  "version": "6.2.1",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "catalog:build": "node scripts/build-canonical-catalog.mjs",
    "catalog:check": "node scripts/build-canonical-catalog.mjs --check",
    "catalog:cards:check": "node scripts/catalog-card-specs.mjs --check --require-reviewed",
    "catalog:cards:complete": "node scripts/catalog-card-specs.mjs --check --require-complete",
    "build:pages": "node scripts/build-pages.mjs",
    "typecheck": "tsc --noEmit",
    "types:generate": "pnpm run build && wrangler types worker-configuration.d.ts --include-env false --config dist/server/wrangler.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "write-excel-file": "^4.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.6",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "description": "Camera equipment and production planning workbench / 摄影器材与项目工作台",
  "license": "MIT",
  "author": "Utiwaaien",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utiwaaaaaien/CineBox.git"
  },
  "bugs": {
    "url": "https://github.com/utiwaaaaaien/CineBox/issues"
  },
  "homepage": "https://github.com/utiwaaaaaien/CineBox#readme",
  "keywords": [
    "cinematography",
    "camera-equipment",
    "production-planning",
    "film",
    "react",
    "typescript"
  ]
}
